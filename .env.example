# ─────────────────────────────────────────────────────────────────────────────
# SCOUT by Arbor Capital — environment
# Copy to .env and fill in. Nothing here is ever rendered into a user-facing
# alert; secrets stay in the backend layer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Primary channels ─────────────────────────────────────────────────────────
# #scout-news receives the complete qualified feed. #trading-floor and
# #spx-trading receive every major market-moving event and always move together
# — there is no configuration in which one gets an event and the other does not.
# Run `npm run discord:setup` to create any that are missing and print the IDs.
DISCORD_CHANNEL_NEWS=
DISCORD_CHANNEL_TRADING_FLOOR=
DISCORD_CHANNEL_SPX=

# ── Per-category channels (optional) ─────────────────────────────────────────
# An additional fan-out alongside the three primary channels. Off by default;
# set CATEGORY_CHANNELS_ENABLED=true to use them.
CATEGORY_CHANNELS_ENABLED=false
DISCORD_CHANNEL_BREAKING=
DISCORD_CHANNEL_MACRO=
DISCORD_CHANNEL_FED=
DISCORD_CHANNEL_GEOPOLITICS=
DISCORD_CHANNEL_MARKETS=
DISCORD_CHANNEL_EQUITIES=
DISCORD_CHANNEL_EARNINGS=
DISCORD_CHANNEL_COMMODITIES=
DISCORD_CHANNEL_OPTIONS=
DISCORD_CHANNEL_CRYPTO=
# Admin-only debug channel (§27). Shows author/handle/URL/filter decisions.
DISCORD_CHANNEL_RAW=
# Admin-only system channel: source health, latency, stats (§22/§23/§28).
DISCORD_CHANNEL_SYSTEM=

# ── 24/7 URL ingestion ───────────────────────────────────────────────────────
# Discord channels Scout watches for X post URLs. Comma-separated channel IDs.
# Detection is event-driven — Scout reacts to new messages and never scrapes
# channel history.
#
# NOTE: reading message text requires the MESSAGE CONTENT intent, which must be
# enabled for the bot in the Discord developer portal. Without it Scout can only
# see links Discord itself expanded into an embed.
NEWS_SOURCE_CHANNEL_IDS=
TRUTH_SOCIAL_CHANNEL_IDS=
ADMIN_INPUT_CHANNEL_IDS=

# Only these X accounts enter the production pipeline.
#
# SET THIS before going live. Empty means EVERY account is accepted, so anyone
# who can post in a watched channel can put a link into #trading-floor and
# #spx-trading. Scout warns loudly on boot — in the log stream and in
# #scout-system — when this is empty while URL ingestion is watching channels,
# but the warning is not a substitute for filling it in.
#
# Comma-separated, with or without the @:
#   ALLOWED_X_ACCOUNTS=DeItaone,FirstSquawk,financialjuice
ALLOWED_X_ACCOUNTS=

# Retrieval budget. Every external call is bounded; a job that exhausts its
# attempts becomes FAILED_RETRIEVAL rather than retrying forever.
RESOLVE_TIMEOUT_SECONDS=10
RESOLVE_MAX_ATTEMPTS=4
INGEST_CONCURRENCY=4

# Freshness for the downstream trading feed. A post older than this — or one
# whose publication time is unknown — may still appear in #scout-news but is
# never handed on as a fresh trading event.
SPROUT_MAX_AGE_MINUTES=30

# HTTP port for /health, /ready, /metrics and POST /webhook/news.
PORT=10000

# ── Webhook ingestion ────────────────────────────────────────────────────────
# Shared secret an upstream source presents to push posts into Scout:
#   POST https://<scout-domain>/webhook/news
#   Authorization: Bearer <SCOUT_WEBHOOK_TOKEN>
# Leave empty to keep the endpoint disabled (it then returns 503). Never logged.
SCOUT_WEBHOOK_TOKEN=

# ── Sprout hand-off — OPTIONAL ───────────────────────────────────────────────
# Where normalized events go for news-aware trading restrictions. Unset means
# Scout publishes to Discord only and records every Sprout delivery as SKIPPED.
# Only events that pass the freshness gate above are ever sent.
SPROUT_URL=
SPROUT_TOKEN=
SPROUT_TIMEOUT_MS=10000

# ── Automatic Sprout recovery ────────────────────────────────────────────────
# The retry schedule is immediate/1s/3s/10s, so an outage longer than that
# leaves deliveries FAILED. Scout re-drives them on this interval, in-process.
# Each pass claims rows in the database, so overlapping runs (or an external
# trigger via POST /admin/replay) can never deliver the same event twice.
# The freshness gate is always re-run against the ORIGINAL published_at, so a
# long outage recovers what is still fresh and correctly declines what is not.
REPLAY_ENABLED=true
REPLAY_INTERVAL_MINUTES=5
REPLAY_WINDOW_MINUTES=60
REPLAY_LIMIT=100

# Secret for POST /admin/replay, if you drive the replay externally.
# Leave EMPTY unless you need it — unset disables the endpoint entirely, which
# is the right default now that the replay runs in-process.
# Use a DIFFERENT value from SCOUT_WEBHOOK_TOKEN. That one is handed to the
# upstream relay so it can push news in; it must not also authorize an
# operational endpoint. There is deliberately no fallback between the two.
SCOUT_ADMIN_TOKEN=

# ── Accepted aliases ─────────────────────────────────────────────────────────
# These names are read when the canonical one above is unset, so a blueprint
# written against either spelling works:
#   DISCORD_TOKEN               → DISCORD_BOT_TOKEN
#   DISCORD_SOURCE_CHANNEL_IDS  → NEWS_SOURCE_CHANNEL_IDS
#   SCOUT_NEWS_CHANNEL_ID       → DISCORD_CHANNEL_NEWS
#   TRADING_FLOOR_CHANNEL_ID    → DISCORD_CHANNEL_TRADING_FLOOR
#   SPX_TRADING_CHANNEL_ID      → DISCORD_CHANNEL_SPX
#   DATABASE_URL                → DATABASE_PATH  (SQLite paths only; a
#                                 postgres:// URL fails loudly rather than
#                                 silently connecting to nothing)

# ── X / Twitter API — OPTIONAL ───────────────────────────────────────────────
# Scout does NOT need this. The primary path reads the content the permitted
# relay already posted alongside the link, so a relayed post is resolved with no
# credential and no second request. This token only adds two things:
#   - a fallback for links relayed WITHOUT their text
#   - polling of the X accounts in config/sources.yaml
# Leaving it empty is a normal configuration. On boot Scout logs
#   X API: NOT CONFIGURED — URL/RELAY INGESTION: ENABLED
# and `npm run sources:verify` reports the X checks as SKIPPED, not failed.
X_BEARER_TOKEN=
# Poll cadence (ms) and the per-15-min request budget Scout will not exceed.
#
# Budget arithmetic matters here: Scout polls every enabled X source on each
# tick, so requests-per-window = enabled_x_sources * (900000 / interval).
# The shipped watchlist has ~14 enabled X sources, so at 90s that is
# 14 * 10 = 140 requests, inside the 180 budget. Lower the interval only if you
# also raise the budget or disable sources — over-subscribing does not break
# anything, but low-priority accounts get skipped on each tick.
X_POLL_INTERVAL_MS=90000
X_REQUEST_BUDGET_PER_WINDOW=180

# ── SEC EDGAR ────────────────────────────────────────────────────────────────
# EDGAR requires a descriptive UA with contact info or it returns 403.
SEC_USER_AGENT=ArborCapital Scout (ops@example.com)
SEC_POLL_INTERVAL_MS=60000

# ── RSS layer ────────────────────────────────────────────────────────────────
RSS_POLL_INTERVAL_MS=45000

# ── Storage ──────────────────────────────────────────────────────────────────
# ALL of Scout's durable state lives in this one file: the processed-post set
# that makes dedupe work, the delivery log the replay reads, and the
# calendar-fired keys that stop a reminder firing twice.
#
# On Render this MUST point at the mounted persistent disk (/var/data/scout.db
# with the disk in render.yaml). On ephemeral storage every deploy wipes it and
# Scout reposts old headlines as breaking news while looking perfectly healthy.
#
# The path below is for local development. Verify the deployed one with
# `curl -s https://<host>/metrics | jq .storage` — `boots` must climb across a
# redeploy. Scout warns on boot if this path cannot be a mounted disk.
DATABASE_PATH=./data/scout.db

# ── Pipeline tuning ──────────────────────────────────────────────────────────
# Minimum importance score (0-100) that reaches a user-facing channel.
# 60 = MODERATE and above. Raise toward 75 for a quieter wire.
MIN_PUBLISH_SCORE=60
# Minimum score for the #scout-breaking channel.
MIN_BREAKING_SCORE=90
# Dedupe window: two posts about the same event inside this window collapse.
DEDUPE_WINDOW_MINUTES=90
# Event clustering window (§18): developments join an open cluster for this long.
CLUSTER_WINDOW_MINUTES=240
# Text similarity threshold (0-1) for near-duplicate detection.
DEDUPE_SIMILARITY=0.82

# ── Ops ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Emit every accepted + rejected decision to #scout-raw. Noisy but useful while
# tuning the filters.
RAW_CHANNEL_ENABLED=true
# Set to true to run the pipeline without sending anything to Discord.
DRY_RUN=false
