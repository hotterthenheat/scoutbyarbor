# ─────────────────────────────────────────────────────────────────────────────
# SCOUT by Arbor Capital — environment
# Copy to .env and fill in. Nothing here is ever rendered into a user-facing
# alert; secrets stay in the backend layer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Channel IDs. Run `npm run discord:setup` to create any that are missing and
# print the IDs to paste back in here.
DISCORD_CHANNEL_BREAKING=
DISCORD_CHANNEL_MACRO=
DISCORD_CHANNEL_FED=
DISCORD_CHANNEL_GEOPOLITICS=
DISCORD_CHANNEL_MARKETS=
DISCORD_CHANNEL_EQUITIES=
DISCORD_CHANNEL_EARNINGS=
DISCORD_CHANNEL_COMMODITIES=
DISCORD_CHANNEL_OPTIONS=
DISCORD_CHANNEL_CRYPTO=
# Admin-only debug channel (§27). Shows author/handle/URL/filter decisions.
DISCORD_CHANNEL_RAW=
# Admin-only system channel: source health, latency, stats (§22/§23/§28).
DISCORD_CHANNEL_SYSTEM=

# ── X / Twitter ingestion ────────────────────────────────────────────────────
# App-only bearer token for X API v2. Without it the twitter adapter stays
# disconnected and Scout runs on the RSS + EDGAR layers only.
X_BEARER_TOKEN=
# Poll cadence (ms) and the per-15-min request budget Scout will not exceed.
X_POLL_INTERVAL_MS=20000
X_REQUEST_BUDGET_PER_WINDOW=180

# ── SEC EDGAR ────────────────────────────────────────────────────────────────
# EDGAR requires a descriptive UA with contact info or it returns 403.
SEC_USER_AGENT=ArborCapital Scout (ops@example.com)
SEC_POLL_INTERVAL_MS=60000

# ── RSS layer ────────────────────────────────────────────────────────────────
RSS_POLL_INTERVAL_MS=45000

# ── Storage ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/scout.db

# ── Pipeline tuning ──────────────────────────────────────────────────────────
# Minimum importance score (0-100) that reaches a user-facing channel.
# 60 = MODERATE and above. Raise toward 75 for a quieter wire.
MIN_PUBLISH_SCORE=60
# Minimum score for the #scout-breaking channel.
MIN_BREAKING_SCORE=90
# Dedupe window: two posts about the same event inside this window collapse.
DEDUPE_WINDOW_MINUTES=90
# Event clustering window (§18): developments join an open cluster for this long.
CLUSTER_WINDOW_MINUTES=240
# Text similarity threshold (0-1) for near-duplicate detection.
DEDUPE_SIMILARITY=0.82

# ── Ops ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Emit every accepted + rejected decision to #scout-raw. Noisy but useful while
# tuning the filters.
RAW_CHANNEL_ENABLED=true
# Set to true to run the pipeline without sending anything to Discord.
DRY_RUN=false
